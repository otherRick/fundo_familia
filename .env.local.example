# Senha usada para acessar a área privada.
# A validação acontece somente no servidor (nunca é exposta ao client).
ACCESS_PASSWORD=

# Segredo usado para assinar o cookie de sessão (HMAC-SHA256).
# Gere um valor longo e aleatório, por exemplo:
#   openssl rand -base64 32
SESSION_SECRET=

# (Opcional) Token da API BRAPI para consultar a cotação atual dos ativos.
# Obtenha em https://brapi.dev -> "Chaves de API".
# Sem token, apenas alguns tickers gratuitos retornam cotação.
BRAPI_TOKEN=

# Supabase (backend). A Service Role Key fica SOMENTE no servidor (nunca no client).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
